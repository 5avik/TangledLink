[Unit]
Description=TangledLink administration panel
After=network-online.target tngl-auth.service
Wants=network-online.target

[Service]
User=tngl-auth
Group=tngl-auth
WorkingDirectory=/opt/tngl-auth
EnvironmentFile=/etc/tngl-auth.env
ExecStart=/opt/node24/bin/node /opt/tngl-auth/admin-panel.mjs
Restart=on-failure
RestartSec=5
StateDirectory=tngl-auth
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tngl-auth
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
