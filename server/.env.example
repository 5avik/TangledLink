SUBSCRIPTION_BASE=https://tngl.pro/tnglsubs/
AUTH_DB=/var/lib/tngl-auth/auth.sqlite
PORT=8080
# Generate a unique random secret (at least 24 characters) before starting tngl-admin.
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
ADMIN_PORT=8081
# Optional manual billing, only for 3x-ui v3.11.0. Keep these commented until configured.
# XUI_URL=https://panel.example.com/YOUR_PANEL_BASE_PATH/
# XUI_API_TOKEN=SET_A_SERVER_ONLY_ADMIN_API_TOKEN
# BILLING_DB=/var/lib/tngl-auth/billing.sqlite
# BILLING_INSTRUCTIONS="Создайте заказ, нажмите «Оплатить» и на странице Choco в поле «Имя» укажите свой логин. Сумма: 150 ₽ за 30 дней. После оплаты вернитесь в приложение и дождитесь подтверждения администратора."
